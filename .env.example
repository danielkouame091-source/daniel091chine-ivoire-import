# =============================================================================
# MTech SaaS SYSCOHADA — Variables d'environnement
# ⚠️ Copier ce fichier vers .env puis remplacer toutes les valeurs sensibles.
# =============================================================================

# ─── Environnement ─────────────────────────────────────────────────────────
ENV=dev
APP_NAME="MTech SaaS SYSCOHADA"
API_PREFIX=/api/v1

# ─── Base de données PostgreSQL ────────────────────────────────────────────
# Format : postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+asyncpg://mtech:mtech_dev_password@postgres:5432/mtech_saas

# ─── Redis (jobs + cache) ──────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── JWT RS256 ─────────────────────────────────────────────────────────────
# Générer avec : python -m scripts.rotate_secrets --output .env.new
JWT_PRIVATE_KEY="""-----BEGIN PRIVATE KEY-----
REMPLACER_PAR_LA_CLE_PRIVEE_GENEREE
-----END PRIVATE KEY-----"""
JWT_PUBLIC_KEY="""-----BEGIN PUBLIC KEY-----
REMPLACER_PAR_LA_CLE_PUBLIQUE_GENEREE
-----END PUBLIC KEY-----"""
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
JWT_MFA_TTL=300

# ─── Chiffrement AES-256-GCM ───────────────────────────────────────────────
# Générer avec : python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=REMPLACER_PAR_UNE_CLE_BASE64_DE_32_OCTETS

# ─── Webhooks Mobile Money ─────────────────────────────────────────────────
WAVE_WEBHOOK_SECRET=changeme_wave_hmac_secret
ORANGE_WEBHOOK_SECRET=changeme_orange_hmac_secret
MTN_WEBHOOK_SECRET=changeme_mtn_hmac_secret
MOOV_WEBHOOK_SECRET=changeme_moov_hmac_secret

# ─── IA ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-remplacer

# ─── Fondateur unique ──────────────────────────────────────────────────────
FOUNDER_EMAIL=daniel@mtech.ci

# ─── CORS ──────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# ─── PostgreSQL (utilisé par docker-compose) ───────────────────────────────
POSTGRES_USER=mtech
POSTGRES_PASSWORD=mtech_dev_password
POSTGRES_DB=mtech_saas
POSTGRES_PORT=5432

# ─── Redis (utilisé par docker-compose) ────────────────────────────────────
REDIS_PORT=6379

# ─── API (utilisé par docker-compose) ──────────────────────────────────────
API_PORT=8000
